NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=server-only-supabase-service-role-key
GOOGLE_CALENDAR_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/google-calendar/callback
GOOGLE_CALENDAR_STATE_SECRET=a-long-random-server-only-string
NTFY_BASE_URL=https://ntfy.sh
NEXT_PUBLIC_NTFY_BASE_URL=https://ntfy.sh
# Optional for a protected/self-hosted ntfy server; never expose this as NEXT_PUBLIC_*.
NTFY_ACCESS_TOKEN=server-only-ntfy-access-token
